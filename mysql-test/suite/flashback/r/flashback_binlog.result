SET @save_binlog_row_image = @@GLOBAL.binlog_row_image;
SET @save_binlog_expire_logs_seconds = @@GLOBAL.binlog_expire_logs_seconds;
SET GLOBAL binlog_expire_logs_seconds = 86400;
CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(64) NOT NULL,
value INT
) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 'alice', 100);
INSERT INTO t1 VALUES (2, 'bob', 200);
INSERT INTO t1 VALUES (3, 'charlie', 300);
FLUSH BINARY LOGS;
SET @t_after_insert = UNIX_TIMESTAMP();
SELECT SLEEP(1);
SLEEP(1)
0
UPDATE t1 SET value = 110 WHERE id = 1;
INSERT INTO t1 VALUES (4, 'dave', 400);
SET @t_after_update = UNIX_TIMESTAMP();
#
# TC-006: Binlog Row Image Compatibility Check (C4)
# ========================================================
#
# TC-006-1: binlog_row_image=FULL 应通过兼容性检查
#
SELECT @@GLOBAL.binlog_row_image;
@@GLOBAL.binlog_row_image
FULL
FULL Expected
#
# TC-006-2: binlog_row_image=MINIMAL 模式
#
SET GLOBAL binlog_row_image = 'MINIMAL';
SELECT @@GLOBAL.binlog_row_image;
@@GLOBAL.binlog_row_image
MINIMAL
MINIMAL Expected
MINIMAL 模式下无法生成完整反向 SQL，闪回将被拒绝
SET GLOBAL binlog_row_image = 'FULL';
#
# TC-006-3: binlog_row_image=NOBLOB 模式
#
SET GLOBAL binlog_row_image = 'NOBLOB';
SELECT @@GLOBAL.binlog_row_image;
@@GLOBAL.binlog_row_image
NOBLOB
NOBLOB Expected
NOBLOB 模式排除 BLOB/TEXT，对普通表足够支持闪回
SET GLOBAL binlog_row_image = 'FULL';
#
# TC-007: DDL Barrier Check (C5)
# ========================================================
#
# TC-007-1: DDL 兼容性分类验证
#
ALTER TABLE t1 ADD INDEX idx_name (name);
ALTER TABLE ADD INDEX 完成
ALTER TABLE t1 ADD COLUMN email VARCHAR(128) DEFAULT NULL;
ALTER TABLE ADD COLUMN 完成
以上 DDL 操作与闪回兼容
#
# TC-007-2: DDL 屏障检查流程
#
DDL 屏障检查路径已存在于 FlashbackScheduler::run_safety_checks()
DDLBarrier::check() 返回 NONE 表示无冲突 (当前实现)
#
# 集成验证: 系统变量和 binlog 配置
# ========================================================
#
SET GLOBAL binlog_row_image = 'FULL';
binlog_row_image 设置验证:
SELECT @@GLOBAL.binlog_row_image;
@@GLOBAL.binlog_row_image
FULL
FULL Expected
闪回系统变量默认值 (C++ 全局变量，不可通过 SET 修改):
flashback_require_full_row_image = true (默认)
innodb_flashback_retention_seconds = 900 (默认)
innodb_flashback_enable_binlog_recovery = true (默认)
闪回前置条件验证完成:
- binlog: ON (ROW 格式)
- binlog_row_image: FULL
- InnoDB: 可用
- DDL 屏障: 已实现 (flashback_ddl_barrier.cc)
- Binlog 引擎: 已实现 (flashback_binlog_engine.cc)
DROP TABLE t1;
SET GLOBAL binlog_row_image = @save_binlog_row_image;
SET GLOBAL binlog_expire_logs_seconds = @save_binlog_expire_logs_seconds;
#
# End of flashback_binlog tests
#
