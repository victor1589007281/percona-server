SET @save_flashback_retention = @@GLOBAL.innodb_flashback_retention_seconds;
SET @save_flashback_binlog_recovery = @@GLOBAL.innodb_flashback_enable_binlog_recovery;
SET @save_flashback_max_rows = @@GLOBAL.flashback_max_rows;
#
# TC-001-01: 闪回查询系统变量默认值
#
# innodb_flashback_retention_seconds: 默认 900 秒 (15 分钟)
# 此变量控制 Undo 版本链的保留时间, 闪回查询的时间窗口受此限制
SELECT @@GLOBAL.innodb_flashback_retention_seconds AS default_retention;
default_retention
900
# innodb_flashback_enable_binlog_recovery: 默认 ON
# 启用基于 Binlog 的长窗口闪回恢复
SELECT @@GLOBAL.innodb_flashback_enable_binlog_recovery AS binlog_recovery;
binlog_recovery
1
# flashback_max_rows: 默认 10000000
# 单次闪回操作的最大行数安全阈值
SELECT @@GLOBAL.flashback_max_rows AS max_rows;
max_rows
10000000
# innodb_flashback_max_rows_per_txn: 默认 100000
SELECT @@GLOBAL.innodb_flashback_max_rows_per_txn AS max_rows_per_txn;
max_rows_per_txn
100000
# flashback_require_full_row_image: 默认 ON
SELECT @@GLOBAL.flashback_require_full_row_image AS require_full_row_image;
require_full_row_image
1
# flashback_lock_wait_timeout: 默认 300
SELECT @@GLOBAL.flashback_lock_wait_timeout AS lock_timeout;
lock_timeout
300
# flashback_dry_run_default: 默认 OFF
SELECT @@GLOBAL.flashback_dry_run_default AS dry_run_default;
dry_run_default
0
#
# TC-001-02: 闪回查询数据准备 — 构造多版本数据
#
CREATE TABLE t_flashback (
id INT PRIMARY KEY,
name VARCHAR(64) NOT NULL,
balance DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
version INT NOT NULL DEFAULT 1,
updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;
# 插入初始数据 (版本 1)
INSERT INTO t_flashback VALUES (1, 'Alice', 1000.00, 1, NOW());
INSERT INTO t_flashback VALUES (2, 'Bob', 2000.00, 1, NOW());
INSERT INTO t_flashback VALUES (3, 'Charlie', 3000.00, 1, NOW());
# 验证初始状态
SELECT id, name, balance, version FROM t_flashback ORDER BY id;
id	name	balance	version
1	Alice	1000.00	1
2	Bob	2000.00	1
3	Charlie	3000.00	1
# 等待 1 秒, 确保时间戳区分
# 第一次更新 (版本 2) — 产生 Undo 记录
UPDATE t_flashback SET balance = 1100.00, version = 2 WHERE id = 1;
UPDATE t_flashback SET balance = 2200.00, version = 2 WHERE id = 2;
# 验证更新后状态
SELECT id, name, balance, version FROM t_flashback ORDER BY id;
id	name	balance	version
1	Alice	1100.00	2
2	Bob	2200.00	2
3	Charlie	3000.00	1
# 等待 1 秒
# 第二次更新 (版本 3) — 产生更多 Undo 记录
UPDATE t_flashback SET balance = 1200.00, version = 3 WHERE id = 1;
INSERT INTO t_flashback VALUES (4, 'Dave', 4000.00, 1, NOW());
# 验证最终状态
SELECT id, name, balance, version FROM t_flashback ORDER BY id;
id	name	balance	version
1	Alice	1200.00	3
2	Bob	2200.00	2
3	Charlie	3000.00	1
4	Dave	4000.00	1
#
# 以上操作在 Undo 表空间中形成了版本链:
#   id=1: v1(balance=1000) → v2(balance=1100) → v3(balance=1200) [当前]
#   id=2: v1(balance=2000) → v2(balance=2200) [当前]
#   id=3: v1(balance=3000) [当前]
#   id=4: v1(balance=4000) [当前]
#
# TC-001-03: MVCC 一致读验证 (闪回查询的基础机制)
#
# 闪回查询的核心是 InnoDB MVCC 一致性读
# START TRANSACTION WITH CONSISTENT SNAPSHOT 获取一个时间点的快照
# 后续读取只看到快照之前的已提交数据, 不受后续修改影响
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT id, name, balance AS snapshot_balance, version AS snapshot_version
FROM t_flashback ORDER BY id;
id	name	snapshot_balance	snapshot_version
1	Alice	1200.00	3
2	Bob	2200.00	2
3	Charlie	3000.00	1
4	Dave	4000.00	1
COMMIT;
# 在快照事务之外修改数据
UPDATE t_flashback SET balance = 1500.00, version = 4 WHERE id = 1;
# 快照事务已提交, 新的读取能看到最新版本
SELECT id, name, balance, version FROM t_flashback WHERE id = 1;
id	name	balance	version
1	Alice	1500.00	4
# 新的快照事务能看到最新版本 (balance=1500)
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT id, name, balance AS latest_balance FROM t_flashback WHERE id = 1;
id	name	latest_balance
1	Alice	1500.00
COMMIT;
#
# TC-001-04: 约束 C9 — 闪回查询不阻塞并发写入
#
# 闪回查询是纯读操作, 使用 MVCC 一致性读, 不加锁
# 因此不会阻塞并发写入操作
# 创建一个快照事务 (模拟闪回查询的读取行为)
START TRANSACTION WITH CONSISTENT SNAPSHOT;
SELECT COUNT(*) AS rows_read FROM t_flashback;
rows_read
4
# 在快照事务进行中, 另一个连接可以同时写入
# (由于 MTR 单连接限制, 这里用顺序方式验证)
# 验证: 快照读取不会持有排他锁
COMMIT;
# 快照事务结束后, 写入操作正常执行
UPDATE t_flashback SET balance = 1600.00, version = 5 WHERE id = 1;
INSERT INTO t_flashback VALUES (5, 'Eve', 5000.00, 1, NOW());
# 验证写入成功
SELECT id, name, balance FROM t_flashback WHERE id IN (1, 5) ORDER BY id;
id	name	balance
1	Alice	1600.00
5	Eve	5000.00
#
# TC-001-05: 闪回查询 — 时间窗口配置
#
# 闪回查询的时间窗口由 innodb_flashback_retention_seconds 控制
# 默认 900 秒 (15 分钟)
# 设置较短的保留窗口用于测试 (最小值 60 秒)
SET GLOBAL innodb_flashback_retention_seconds = 60;
SELECT @@GLOBAL.innodb_flashback_retention_seconds AS short_retention;
short_retention
60
# 设置回默认值
SET GLOBAL innodb_flashback_retention_seconds = 900;
SELECT @@GLOBAL.innodb_flashback_retention_seconds AS restored_retention;
restored_retention
900
# 闪回调度器选择引擎的逻辑:
#   1. QUERY/VERSIONS 类型只能使用 UNDO 引擎 (Binlog 不支持只读查询)
#   2. 目标时间在 undo_retention 窗口内 → UNDO 引擎
#   3. 目标时间超出 undo_retention → OUT_OF_WINDOW
#
# TC-001-06: 闪回查询 — FlashbackScheduler 执行路径
#
# FlashbackScheduler::execute_flashback_query() 执行流程:
# 1. 设置 result.state = RUNNING
# 2. 设置 result.engine_used = UNDO
# 3. 通过 InnoDB ha_innobase 的闪回上下文设置
# 4. row_build_flashback_version() 构建历史版本
# 当前实现中, execute_flashback_query() 返回 false (成功)
# 完整的版本链构建需要接入 row0vers.cc 中的版本遍历逻辑
# 验证闪回请求参数结构:
#   type = QUERY (SELECT ... AS OF TIMESTAMP)
#   engine = AUTO (调度器自动选择, 对 QUERY 类型强制使用 UNDO)
#   target_time = 目标时间戳 (秒级精度)
# 闪回查询只读特性:
#   - 不修改任何数据页
#   - 不生成 redo log
#   - 不阻塞并发写入 (约束 C9)
#
# TC-004-01: Undo 过期错误 — 时间窗口外查询
#
# 当闪回查询的目标时间超出 Undo 保留窗口时,
# 应返回 FlashbackError::UNDO_PURGED 或 OUT_OF_WINDOW
# 设置极短的保留窗口 (60 秒) 便于测试
SET GLOBAL innodb_flashback_retention_seconds = 60;
SELECT @@GLOBAL.innodb_flashback_retention_seconds AS very_short_retention;
very_short_retention
60
# 创建一张新表用于测试过期场景
CREATE TABLE t_undo_expire (
id INT PRIMARY KEY,
data VARCHAR(256)
) ENGINE=InnoDB;
INSERT INTO t_undo_expire VALUES (1, 'initial_data');
INSERT INTO t_undo_expire VALUES (2, 'more_data');
# 记录当前时间戳
SET @now = UNIX_TIMESTAMP();
# 更新数据产生 undo 记录
UPDATE t_undo_expire SET data = 'updated_data' WHERE id = 1;
# 验证当前数据
SELECT id, data FROM t_undo_expire ORDER BY id;
id	data
1	updated_data
2	more_data
# Undo 保留窗口验证:
# - innodb_flashback_retention_seconds=60
# - 目标时间 < (now - 60) 时, undo 可能已被 purge
# - FlashbackScheduler::select_engine() 会检测到窗口超出
# - 返回 FlashbackError::OUT_OF_WINDOW 或 UNDO_PURGED
# 注意: Undo 的实际 purge 由 purge 线程异步执行,
# 有活跃读视图时会延迟 purge (read view 保护机制)
#
# TC-004-02: 保留窗口恢复
#
# 恢复默认保留窗口
SET GLOBAL innodb_flashback_retention_seconds = 900;
SELECT @@GLOBAL.innodb_flashback_retention_seconds AS default_restored;
default_restored
900
# 验证所有系统变量在正常范围
SELECT
@@GLOBAL.innodb_flashback_retention_seconds AS retention,
@@GLOBAL.innodb_flashback_enable_binlog_recovery AS binlog_recovery,
@@GLOBAL.innodb_flashback_max_rows_per_txn AS max_rows_txn,
@@GLOBAL.flashback_dry_run_default AS dry_run,
@@GLOBAL.flashback_require_full_row_image AS full_row_image,
@@GLOBAL.flashback_lock_wait_timeout AS lock_timeout,
@@GLOBAL.flashback_max_rows AS max_rows;
retention	binlog_recovery	max_rows_txn	dry_run	full_row_image	lock_timeout	max_rows
900	1	100000	0	1	300	10000000
DROP TABLE IF EXISTS t_flashback, t_undo_expire;
SET GLOBAL innodb_flashback_retention_seconds = @save_flashback_retention;
SET GLOBAL innodb_flashback_enable_binlog_recovery = @save_flashback_binlog_recovery;
SET GLOBAL flashback_max_rows = @save_flashback_max_rows;
#
# End of flashback_query tests (TC-001, TC-004)
#
