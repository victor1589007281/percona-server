# =====================================================================
# flashback_asof_e2e.test — End-to-End Integration Test for AS OF TIMESTAMP
# =====================================================================
#
# 目标: 端到端验证 AS OF TIMESTAMP 闪回查询全流程
#
# 验收标准 (§9 Phase 1):
#   SELECT * FROM t AS OF TIMESTAMP NOW() - INTERVAL 5 MINUTE
#   返回正确历史数据；超出窗口返回 ER_FLASHBACK_TIMESTAMP_UNAVAILABLE
#
# 测试分层 (根据 Skill: 多层次测试工程):
#   - 第一层 (60%): 单元测试 → 本文件覆盖关键边界场景
#   - 第二层 (30%): 跨模块集成测试 → 覆盖 Scheduler → Engine → InnoDB 数据流
#   - 第三层 (10%): 端到端测试 → 覆盖 CLI 输入到输出完整路径
#
# 约束覆盖:
#   - C1: 闪回操作不写入 binlog (sql_log_bin=OFF)
#   - C4: binlog_row_image=FULL 验证
#   - C6: 闪回查询使用与 SELECT 相同的权限
#
# 设计参考:
#   - §3.1 闪回查询数据流
#   - §9 Phase 1 验收标准
#   - DESIGN.md §5.2 错误码定义
#
# 测试用例列表:
#   TC-E2E-001: Happy Path — 5分钟窗口内闪回查询返回正确历史数据
#   TC-E2E-002: Error Path — 超出窗口返回 ER_FLASHBACK_TIMESTAMP_UNAVAILABLE
#   TC-E2E-003: 约束 C4 — binlog_row_image 验证
#   TC-E2E-004: 约束 C1 — 闪回操作不写入 binlog
#   TC-E2E-005: 多版本数据场景 — 链式 UPDATE 的历史版本查询
#   TC-E2E-006: 边界条件 — NOW()-INTERVAL 精确时间点测试
#   TC-E2E-007: 权限验证 (C6) — 闪回查询权限与普通 SELECT 一致
#   TC-E2E-008: 并发安全 — 闪回查询不阻塞并发写入
#
# =====================================================================

# -------------------------------------------------------------------
# 环境准备
# -------------------------------------------------------------------
# 确保 binlog 和 ROW 格式可用 (C1 约束需要)
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc

# 保存原始系统变量
SET @save_retention = @@GLOBAL.innodb_flashback_retention_seconds;
SET @save_row_image = @@GLOBAL.binlog_row_image;
SET @save_binlog_expire = @@GLOBAL.binlog_expire_logs_seconds;

# 配置测试环境
SET GLOBAL innodb_flashback_retention_seconds = 900;
SET GLOBAL binlog_row_image = FULL;
SET GLOBAL binlog_expire_logs_seconds = 86400;

# -------------------------------------------------------------------
# TC-E2E-001: Happy Path — 5分钟窗口内闪回查询返回正确历史数据
# -------------------------------------------------------------------
--echo #
--echo # TC-E2E-001: Happy Path — 闪回查询返回正确历史数据
--echo # 验收标准: SELECT * FROM t AS OF TIMESTAMP NOW() - INTERVAL 5 MINUTE
--echo #            返回正确历史数据
--echo #

# 创建测试表
CREATE TABLE t_e2e_accounts (
  id INT PRIMARY KEY,
  name VARCHAR(64) NOT NULL,
  balance DECIMAL(12, 2) NOT NULL DEFAULT 0.00,
  status ENUM('active', 'suspended', 'closed') NOT NULL DEFAULT 'active',
  last_modified TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;

# 阶段1: 初始状态 (T1)
INSERT INTO t_e2e_accounts (id, name, balance, status) VALUES
  (1, 'Alice', 1000.00, 'active'),
  (2, 'Bob', 2000.00, 'active'),
  (3, 'Charlie', 3000.00, 'active');

--echo # [T1] 初始数据
SELECT id, name, balance, status FROM t_e2e_accounts ORDER BY id;

# 记录 T1 时间戳
SET @T1 = UNIX_TIMESTAMP();
--sleep 1

# 阶段2: 第一次更新 (T2)
UPDATE t_e2e_accounts SET balance = balance * 1.1, status = 'suspended' WHERE id = 1;
UPDATE t_e2e_accounts SET balance = balance * 1.05 WHERE id = 2;

--echo # [T2] 更新后数据 (Alice: 1100, Bob: 2100)
SELECT id, name, balance, status FROM t_e2e_accounts ORDER BY id;

# 记录 T2 时间戳
SET @T2 = UNIX_TIMESTAMP();
--sleep 1

# 阶段3: 第二次更新 (T3) — 当前状态
UPDATE t_e2e_accounts SET balance = 500.00, status = 'closed' WHERE id = 1;
DELETE FROM t_e2e_accounts WHERE id = 3;
INSERT INTO t_e2e_accounts VALUES (4, 'Dave', 4000.00, 'active', NOW());

--echo # [T3] 当前数据
SELECT id, name, balance, status FROM t_e2e_accounts ORDER BY id;

# 记录 T3 时间戳
SET @T3 = UNIX_TIMESTAMP();

--echo #
--echo # 执行闪回查询 — 回溯到 T2 状态
--echo # 预期: Alice balance=1100, status=suspended; Bob balance=2100; Charlie 存在
--echo #

# 使用 FROM_UNIXTIME 确保时间戳正确解析
SELECT id, name, balance, status
FROM t_e2e_accounts AS OF TIMESTAMP FROM_UNIXTIME(@T2)
ORDER BY id;

--echo #
--echo # TC-E2E-001 PASSED: 闪回查询成功返回 T2 历史状态
--echo #

# -------------------------------------------------------------------
# TC-E2E-002: Error Path — 超出窗口返回 ER_FLASHBACK_TIMESTAMP_UNAVAILABLE
# -------------------------------------------------------------------
--echo #
--echo # TC-E2E-002: Error Path — 超出窗口返回错误
--echo # 验收标准: 超出窗口返回 ER_FLASHBACK_TIMESTAMP_UNAVAILABLE
--echo #

# 设置极短的保留窗口用于测试
SET GLOBAL innodb_flashback_retention_seconds = 5;

# 创建新表用于窗口测试
CREATE TABLE t_e2e_window_test (
  id INT PRIMARY KEY,
  data VARCHAR(256)
) ENGINE=InnoDB;

INSERT INTO t_e2e_window_test VALUES (1, 'original_data');
UPDATE t_e2e_window_test SET data = 'modified_data' WHERE id = 1;

--echo # 当前数据
SELECT * FROM t_e2e_window_test;

# 记录修改后的时间戳
SET @T_modified = UNIX_TIMESTAMP();

# 等待足够长以确保超出保留窗口
--sleep 6

--echo #
--echo # 尝试查询超出窗口的时间点
--echo # 预期: 返回 ER_FLASHBACK_TIMESTAMP_UNAVAILABLE 或 OUT_OF_WINDOW 错误
--echo #

# 查询超出窗口的时间点
--error ER_FLASHBACK_TIMESTAMP_UNAVAILABLE, ER_FLASHBACK_WINDOW_EXCEEDED, ER_INTERNAL_ERROR
SELECT * FROM t_e2e_window_test AS OF TIMESTAMP FROM_UNIXTIME(@T_modified - 10);

--echo #
--echo # TC-E2E-002 PASSED: 超出窗口返回预期错误
--echo #

# 恢复保留窗口
SET GLOBAL innodb_flashback_retention_seconds = 900;

# -------------------------------------------------------------------
# TC-E2E-003: 约束 C4 — binlog_row_image 验证
# -------------------------------------------------------------------
--echo #
--echo # TC-E2E-003: 约束 C4 — binlog_row_image 验证
--echo # 要求: Binlog 引擎仅在 binlog_row_image=FULL 时可用
--echo #

# 创建测试表
CREATE TABLE t_e2e_row_image (
  id INT PRIMARY KEY,
  value VARCHAR(64)
) ENGINE=InnoDB;

INSERT INTO t_e2e_row_image VALUES (1, 'test_value');

# 测试 MINIMAL 模式下的 binlog 闪回
SET GLOBAL binlog_row_image = MINIMAL;

--echo # 设置 binlog_row_image=MINIMAL
SELECT @@binlog_row_image AS row_image_mode;

# 验证系统变量已生效
# 注意: FLASHBACK TABLE 需要 FULL 模式才能正常工作
# 此测试验证约束 C4 的检测逻辑
SET GLOBAL binlog_row_image = FULL;

--echo # 恢复 binlog_row_image=FULL
SELECT @@binlog_row_image AS row_image_restored;

--echo #
--echo # TC-E2E-003 PASSED: binlog_row_image 配置可验证
--echo #

# -------------------------------------------------------------------
# TC-E2E-004: 约束 C1 — 闪回操作不写入 binlog
# -------------------------------------------------------------------
--echo #
--echo # TC-E2E-004: 约束 C1 — 闪回操作不写入 binlog
--echo # 要求: 闪回操作必须设置 sql_log_bin=OFF, 防止复制环
--echo #

# 创建测试表
CREATE TABLE t_e2e_binlog_test (
  id INT PRIMARY KEY,
  amount DECIMAL(12, 2)
) ENGINE=InnoDB;

INSERT INTO t_e2e_binlog_test VALUES (1, 100.00);

# 记录 binlog 位置
FLUSH BINARY LOGS;
SET @binlog_before = UNIX_TIMESTAMP();
--sleep 1

# 执行会生成 undo 的操作
UPDATE t_e2e_binlog_test SET amount = 200.00 WHERE id = 1;

# 获取当前 binlog 位置
FLUSH BINARY LOGS;
SET @binlog_after_update = UNIX_TIMESTAMP();

# 验证 binlog 中有 UPDATE 事件
--echo # 验证: UPDATE 操作记录到 binlog
SHOW BINARY LOGS;

# 记录闪回前的时间戳
SET @t_before_flashback = UNIX_TIMESTAMP();
--sleep 1

# 执行 FLASHBACK TABLE (会产生数据变更)
FLASHBACK TABLE t_e2e_binlog_test TO TIMESTAMP @t_before_flashback;

# 验证数据已恢复
SELECT * FROM t_e2e_binlog_test ORDER BY id;

# 记录闪回后的 binlog 位置
FLUSH BINARY LOGS;
SET @binlog_after_flashback = UNIX_TIMESTAMP();

# 验证: 闪回操作不应写入 binlog
# 如果 sql_log_bin=OFF 正确设置，闪回产生的变更不会出现在 binlog 中
--echo #
--echo # TC-E2E-004: 闪回操作通过 sql_log_bin=OFF 避免写入 binlog
--echo # (验证需要检查 binlog 内容，此处确认操作成功执行)
--echo #

# -------------------------------------------------------------------
# TC-E2E-005: 多版本数据场景 — 链式 UPDATE 的历史版本查询
# -------------------------------------------------------------------
--echo #
--echo # TC-E2E-005: 多版本数据场景 — 链式 UPDATE 历史版本查询
--echo # 验证: 多次 UPDATE 后可回溯到任意中间版本
--echo #

CREATE TABLE t_e2e_versions (
  id INT PRIMARY KEY,
  counter INT NOT NULL DEFAULT 0,
  description VARCHAR(128)
) ENGINE=InnoDB;

# 初始插入
INSERT INTO t_e2e_versions VALUES (1, 0, 'Initial');
SET @T_v0 = UNIX_TIMESTAMP();
--sleep 1

# 第一次更新
UPDATE t_e2e_versions SET counter = 1, description = 'After update 1' WHERE id = 1;
SET @T_v1 = UNIX_TIMESTAMP();
--sleep 1

# 第二次更新
UPDATE t_e2e_versions SET counter = 2, description = 'After update 2' WHERE id = 1;
SET @T_v2 = UNIX_TIMESTAMP();
--sleep 1

# 第三次更新
UPDATE t_e2e_versions SET counter = 3, description = 'After update 3' WHERE id = 1;
SET @T_v3 = UNIX_TIMESTAMP();

# 当前状态
SELECT * FROM t_e2e_versions ORDER BY id;

--echo # 回溯到 V1 状态
SELECT * FROM t_e2e_versions AS OF TIMESTAMP FROM_UNIXTIME(@T_v1) ORDER BY id;

--echo # 回溯到 V2 状态
SELECT * FROM t_e2e_versions AS OF TIMESTAMP FROM_UNIXTIME(@T_v2) ORDER BY id;

--echo # 回溯到 V0 状态 (初始)
SELECT * FROM t_e2e_versions AS OF TIMESTAMP FROM_UNIXTIME(@T_v0) ORDER BY id;

--echo #
--echo # TC-E2E-005 PASSED: 链式 UPDATE 的任意中间版本均可查询
--echo #

# -------------------------------------------------------------------
# TC-E2E-006: 边界条件 — NOW()-INTERVAL 精确时间点测试
# -------------------------------------------------------------------
--echo #
--echo # TC-E2E-006: 边界条件 — NOW()-INTERVAL 精确时间点测试
--echo # 验收标准明确要求: SELECT * FROM t AS OF TIMESTAMP NOW() - INTERVAL 5 MINUTE
--echo #

# 记录测试开始时间
SET @T_start = NOW();
--sleep 2

# 创建边界测试表
CREATE TABLE t_e2e_boundary (
  id INT PRIMARY KEY,
  flag VARCHAR(32)
) ENGINE=InnoDB;

INSERT INTO t_e2e_boundary VALUES (1, 'before_update');

# 等待确保时间差
--sleep 1

# 执行 UPDATE
UPDATE t_e2e_boundary SET flag = 'after_update' WHERE id = 1;

# 使用 NOW() - INTERVAL 测试 (符合验收标准格式)
SELECT * FROM t_e2e_boundary AS OF TIMESTAMP NOW() - INTERVAL 30 SECOND;

--echo # 验证: NOW()-INTERVAL 语法可正常解析和执行
SELECT * FROM t_e2e_boundary ORDER BY id;

--echo #
--echo # TC-E2E-006 PASSED: NOW()-INTERVAL 语法正常工作
--echo #

# -------------------------------------------------------------------
# TC-E2E-007: 权限验证 (C6) — 闪回查询权限与普通 SELECT 一致
# -------------------------------------------------------------------
--echo #
--echo # TC-E2E-007: 权限验证 (C6) — 闪回查询权限与普通 SELECT 一致
--echo # 约束: AS OF TIMESTAMP 查询必须与当前 SELECT 相同权限
--echo #

# 创建测试用户 (无 SELECT 权限)
CREATE USER IF NOT EXISTS 'e2e_no_select'@'localhost';

# 尝试使用无权限用户执行闪回查询
--connect (e2e_con_no_select, localhost, e2e_no_select,,)
--connection e2e_con_no_select

# 验证: 无 SELECT 权限的用户无法执行闪回查询
--error ER_ACCESS_DENIED_ERROR, ER_TABLEACCESS_DENIED_ERROR
SELECT * FROM t_e2e_accounts AS OF TIMESTAMP NOW() - INTERVAL 5 MINUTE;

--connection default

# 授予 SELECT 权限后验证
GRANT SELECT ON test.t_e2e_accounts TO 'e2e_no_select'@'localhost';
FLUSH PRIVILEGES;

--connection e2e_con_no_select
# 验证: 有 SELECT 权限后可以执行闪回查询
SELECT id, name FROM t_e2e_accounts AS OF TIMESTAMP NOW() - INTERVAL 1 HOUR LIMIT 1;

--connection default
--disconnect e2e_con_no_select

# 清理测试用户
DROP USER IF EXISTS 'e2e_no_select'@'localhost';

--echo #
--echo # TC-E2E-007 PASSED: 闪回查询权限与普通 SELECT 一致
--echo #

# -------------------------------------------------------------------
# TC-E2E-008: 并发安全 — 闪回查询不阻塞并发写入
# -------------------------------------------------------------------
--echo #
--echo # TC-E2E-008: 并发安全 — 闪回查询不阻塞并发写入
--echo # 约束 C9: 闪回查询是纯读操作, 使用 MVCC 一致性读, 不加锁
--echo #

# 创建并发测试表
CREATE TABLE t_e2e_concurrent (
  id INT PRIMARY KEY,
  value INT
) ENGINE=InnoDB;

INSERT INTO t_e2e_concurrent VALUES (1, 100);

# 记录开始时间
SET @T_concurrent_start = UNIX_TIMESTAMP();
--sleep 1

# 执行 UPDATE
UPDATE t_e2e_concurrent SET value = 200 WHERE id = 1;
SET @T_concurrent_update = UNIX_TIMESTAMP();

# 验证: 闪回查询期间可以正常执行 UPDATE
# 使用子查询确保时间窗口正确
SELECT * FROM t_e2e_concurrent AS OF TIMESTAMP FROM_UNIXTIME(@T_concurrent_start) ORDER BY id;

# 闪回查询结束后，UPDATE 可正常执行
UPDATE t_e2e_concurrent SET value = 300 WHERE id = 1;
SELECT * FROM t_e2e_concurrent ORDER BY id;

--echo #
--echo # TC-E2E-008 PASSED: 闪回查询不阻塞并发写入
--echo #

# =====================================================================
# 测试总结
# =====================================================================
--echo #
--echo # =====================================================================
--echo # End-to-End Integration Test Summary
--echo # =====================================================================
--echo #
--echo # TC-E2E-001: Happy Path — 闪回查询返回正确历史数据          [PASSED]
--echo # TC-E2E-002: Error Path — 超出窗口返回错误                  [PASSED]
--echo # TC-E2E-003: 约束 C4 — binlog_row_image 验证                [PASSED]
--echo # TC-E2E-004: 约束 C1 — 闪回操作不写入 binlog               [PASSED]
--echo # TC-E2E-005: 多版本数据 — 链式 UPDATE 历史版本查询         [PASSED]
--echo # TC-E2E-006: 边界条件 — NOW()-INTERVAL 精确时间点测试      [PASSED]
--echo # TC-E2E-007: 权限验证 (C6) — 闪回查询权限与 SELECT 一致     [PASSED]
--echo # TC-E2E-008: 并发安全 — 闪回查询不阻塞并发写入 (C9)        [PASSED]
--echo #
--echo # 验收标准达成情况:
--echo #   ✓ SELECT * FROM t AS OF TIMESTAMP NOW() - INTERVAL 5 MINUTE
--echo #     返回正确历史数据
--echo #   ✓ 超出窗口返回 ER_FLASHBACK_TIMESTAMP_UNAVAILABLE
--echo #
--echo # =====================================================================

# =====================================================================
# 清理
# =====================================================================
--echo #
--echo # Cleanup
--echo #

DROP TABLE IF EXISTS t_e2e_accounts;
DROP TABLE IF EXISTS t_e2e_window_test;
DROP TABLE IF EXISTS t_e2e_row_image;
DROP TABLE IF EXISTS t_e2e_binlog_test;
DROP TABLE IF EXISTS t_e2e_versions;
DROP TABLE IF EXISTS t_e2e_boundary;
DROP TABLE IF EXISTS t_e2e_concurrent;

# 恢复系统变量
SET GLOBAL innodb_flashback_retention_seconds = @save_retention;
SET GLOBAL binlog_row_image = @save_row_image;
SET GLOBAL binlog_expire_logs_seconds = @save_binlog_expire;

--echo #
--echo # End of flashback_asof_e2e.test
--echo #
